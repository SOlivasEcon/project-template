# Per-machine settings: copy this file to `.env` and fill in the paths. `.env` is never committed.
# Paths may be absolute or start with ~; relative paths are read from the repo root.

# Raw data, outside the repo (any local or cloud-synced folder). The demo tasks do not need it.
DATA_ROOT=
# Task outputs go to OUTPUT_ROOT/tasks/<task>/. Keep it local, not cloud-synced: SCons tracks it per clone.
OUTPUT_ROOT=
# Optional: a folder shared with coauthors that the publish task copies final results into.
SHARED_OUTPUT_ROOT=

# Programs for non-Python tasks. Leave empty to search PATH; a task whose program is not found is skipped.
# Windows: C:\Program Files\Stata18\StataMP-64.exe   Mac: /Applications/Stata/StataMP.app/Contents/MacOS/stata-mp
STATA_EXE=
# Rscript, not R: Windows C:\Program Files\R\R-4.x.x\bin\Rscript.exe   Mac: /usr/local/bin/Rscript
R_EXE=
# Windows: C:\Program Files\MATLAB\R2024a\bin\matlab.exe   Mac: /Applications/MATLAB_R2024a.app/bin/matlab
MATLAB_EXE=
# Windows: %LOCALAPPDATA%\Programs\Julia-1.x.x\bin\julia.exe (write the full path)   Mac: ~/.juliaup/bin/julia
JULIA_EXE=
